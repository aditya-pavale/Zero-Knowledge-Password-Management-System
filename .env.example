# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (leave unset to fall back to SQLite for quick local dev)
DATABASE_URL=postgres://vault:vault@localhost:5432/vault

# Comma-separated origins allowed to call the API from another origin (optional)
CORS_ALLOWED_ORIGINS=

# AI security analyzer (optional; without a key a built-in offline knowledge base is used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# docker compose
POSTGRES_PASSWORD=change-me
